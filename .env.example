# Telegram
TELEGRAM_BOT_TOKEN=           # From @BotFather
TELEGRAM_USER_ID=             # Your numeric user ID from @userinfobot

# Whoop OAuth
WHOOP_CLIENT_ID=              # From developer-dashboard.whoop.com
WHOOP_CLIENT_SECRET=          # From developer-dashboard.whoop.com

# Google Sheets (Apps Script web app URL — no service account needed)
GOOGLE_APPS_SCRIPT_URL=       # From deploying the Apps Script (see README)

# APIs
GROQ_API_KEY=                 # From console.groq.com
ANTHROPIC_API_KEY=            # From console.anthropic.com

# Supabase
SUPABASE_URL=                 # From Supabase project settings
SUPABASE_KEY=                 # Service role key

# Schedule (optional)
CHECKIN_HOUR=20               # 24h format, default 8 PM
CHECKIN_MINUTE=0
TIMEZONE=Asia/Kolkata
